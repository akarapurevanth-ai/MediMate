# MediMate AI Assistant Environment Variables
# Configure your preferred AI provider below.
# The backend supports Google Gemini, OpenAI, and Groq.
# If none is configured, MediMate will use its built-in NHS/MedlinePlus Clinical Knowledge Engine
# and clearly inform the user that live generative AI is not yet configured.

# Option 1: Google Gemini (Recommended - Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# Option 2: OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Option 3: Groq (Fast open-source inference at https://console.groq.com/)
GROQ_API_KEY=

# Server Port (Optional, defaults to 8000)
PORT=8000
